SECRET_KEY=change-me-to-a-secure-random-32-byte-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL connection string (or SQLite for local dev)
# For Neon / cloud Postgres: postgresql+asyncpg://user:pass@host/dbname?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/taskpulse
# DATABASE_URL=sqlite+aiosqlite:///./taskpulse.db

# Redis connection string (cache & Celery broker)
REDIS_URL=redis://localhost:6379/0

